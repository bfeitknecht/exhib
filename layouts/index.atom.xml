{{- $entries := where site.RegularPages "Section" "pieces" -}}
{{- with site.GetPage "/collections" -}}
  {{- range .Sections -}}{{- $entries = $entries | append . -}}{{- end -}}
{{- end -}}
{{- $entries = sort $entries "Date" "desc" -}}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <id>{{ site.BaseURL }}</id>
  <title>{{ site.Title }}</title>
  <updated>{{ now.Format "2006-01-02T15:04:05Z07:00" }}</updated>
  <link href="{{ "atom.xml" | absURL }}" rel="self" type="application/atom+xml" />
  <link href="{{ site.BaseURL }}" rel="alternate" />
  <author><name>{{ site.Title }}</name></author>
  {{ range $entries }}
  <entry>
    <id>{{ .Permalink }}</id>
    <title>{{ .Title }}</title>
    <link href="{{ .Permalink }}" rel="alternate" />
    <published>{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}</published>
    <updated>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated>
    <summary>{{ .Description }}</summary>
  </entry>
  {{ end }}
</feed>
